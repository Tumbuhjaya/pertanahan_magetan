        function cari_nama_jenazah(params,status) {
            if ($('#nama_jenazah_'+params).val() || $('#tahun_jenazah_'+params).val() ) {

            $(`#`+params).empty()
            $.post(`/get_nama_pemohon`,{kolom:'jns_pemakaman' , val_kol:status , nama_jenazah:$('#nama_jenazah_'+params).val(),tanggal_meninggal:$('#tahun_jenazah_'+params).val()  }).then(function (hsl) {
                $(`#`+params).append(`<option value="">-- Silahkan pilih nama jenazah --</option>`)
                for (let i = 0; i < hsl.data.length; i++) {
                    $(`#`+params).append(`<option value="${hsl.data[i].nama_jenazah}">${hsl.data[i].nama_jenazah}</option>`)
                }
            })
        }
        }
