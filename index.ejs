	right: -240px;
	top: 0;
	transition: transform 600ms cubic-bezier(0.25, 0.1, 0.25, 1);
	width: 240px;
	z-index: 1000;
  }
  .builder .inner .builder-container {
	padding: 20px;
  }
  
