                  function loadRdtr(data) {
                    console.log('loadRdtr');
                    
    rdtr_layer.clearLayers();
    rdtr_layer.addData(data);
    rdtr_layer.addTo(map);
    rdtr_layer.eachLayer(function(layer) {
        layer.setStyle({
            color: '#ff7800',        // warna garis oranye
            weight: 2,
            opacity: 0.8,
            fillOpacity: 0.3,
            fillColor: '#ff7800'
        });
        // Popup menampilkan atribut
        var props = layer.feature.properties;
        var popupContent = '<b>Nama:</b> ' + (props.namobj || '') +
                           '<br><b>Kode Sub Z:</b> ' + (props.kode_sub_z || '');
        layer.bindPopup(popupContent);
    });
}

function loadKabmagetan(data) {
  console.log('loadKabmagetan');
  
    kabmagetan_layer.clearLayers();
    kabmagetan_layer.addData(data);
    kabmagetan_layer.addTo(map);
    kabmagetan_layer.eachLayer(function(layer) {
        layer.setStyle({
            color: '#3388ff',        // warna garis biru
            weight: 2,
            opacity: 0.8,
            fillOpacity: 0.3,
            fillColor: '#3388ff'
        });
        var props = layer.feature.properties;
        var popupContent = '<b>Nama:</b> ' + (props.namobj || '');
        layer.bindPopup(popupContent);
    });
}
async function cari(params) {
    function buildQueryString(filters) {
        let params = new URLSearchParams();
        for (let key in filters) {
            if (filters[key]) {
                params.append(key, filters[key]);
            }
        }
        return params.toString() ? '?' + params.toString() : '';
    }
    
    // Kumpulkan filter
    let filters = {};
    if ($('#kecamatan_filter').val()) {
        filters.id_kec = $('#kecamatan_filter').val();
    }
    if ($('#desa_filter').val()) {
        filters.id_kel = $('#desa_filter').val();
    }
    if ($('#nm_pnguasa').val()) {
        filters.nm_pnguasa = $('#nm_pnguasa').val();
    }
    
    let queryString = buildQueryString(filters);
    
    // Gunakan Promise.all untuk memuat semua data secara parallel
    try {
        const [geoJsonData, percilData] = await Promise.all([
            $.getJSON(root + "peta/topojson_kel" + queryString),
            $.getJSON(root + "peta/topojson_persil" + queryString),
            // $.getJSON(root + "peta/topojson_rdtr" + queryString)
        ]);
        
        // Proses semua data setelah selesai dimuat
        loadGeoJsonkec(geoJsonData);
        loadGeoJsonPersil(percilData);
        // loadRdtr(rdtrData);
        
    } catch (error) {
        console.error('Gagal memuat data:', error);
    }
}
