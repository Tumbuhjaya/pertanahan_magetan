    console.log('loadGeoJsonkec');

    kabupaten_layer.addTo(map);

    var i = 0;
    var labelnya = "";
    kabupaten_layer.eachLayer(function (layer) {
        layer.setStyle(style_kabupaten);
        var bounds = layer.getBounds();
        var center = bounds.getCenter();
        label_kec[i] = new L.Tooltip({
            noHide: false,
            direction: 'auto',
            permanent: true
        });
        labelnya = layer.feature.properties.kab;
        label_kec[i].setContent(labelnya);
        label_kec[i].setLatLng(center);
        map.showLabel(label_kec[i]);
        layer.on('click', function (e) {
            // ...
        });
        i++;
    });
    hide_label_kec();

    // 🔁 ZOOM OTOMATIS ke seluruh kecamatan
    if (kabupaten_layer.getLayers().length > 0) {
        map.fitBounds(kabupaten_layer.getBounds(), {
            padding: [20, 20],   // beri jarak tepi
            maxZoom: 12          // batas zoom maksimal agar tidak terlalu dekat
        });
    }
}
