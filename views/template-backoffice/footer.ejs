  // Validasi file menggunakan JavaScript
  const MAX_FILE_SIZE = 500 * 1024 ;
  function cek_file(file) {
    // Periksa apakah file ada
    const validType = file.type === "image/jpeg";

    if (!file) {
      return "Silakan pilih file terlebih dahulu.";
    }else

    // Validasi ukuran file
    if (file.size > MAX_FILE_SIZE) {
      return "Ukuran file melebihi 500KB.";
    }else

    // Validasi tipe file
    if (!validType) {
      return "Hanya file .jpg yang diperbolehkan."
    }else

    // Reset pesan kesalahan jika lolos validasi
    {return ""}
  }
   function renderPagination(totalData, currentPage, maxPages , itemsPerPage , ubah_table , tabs) {
        let tab = tabs?tabs:''
      const pagination = document.querySelector('#pagination'+tab);
      pagination.innerHTML = '';
    
      const totalPages = Math.ceil(totalData / itemsPerPage);
    
      function addPageButton(pageNumber) {
        const link = document.createElement('button');
        link.textContent = pageNumber;
        link.onclick = function () {
            ubah_table(pageNumber)
        } 
        if (pageNumber === currentPage) {
          link.classList.add('active');
        }
    
        link.addEventListener('click', function () {
          currentPage = pageNumber;
          renderPagination(totalData, currentPage, maxPages,itemsPerPage,ubah_table, tabs );
        });
    
        pagination.appendChild(link);
      }
    
      function addEllipsis() {
        const ellipsis = document.createElement('button');
        ellipsis.textContent = '...';
        pagination.appendChild(ellipsis);
      }
    
      if (currentPage > 1) {
        const firstButton = document.createElement('button');
        
        firstButton.textContent = 'First';
        firstButton.onclick = function () {
            ubah_table(1)
        } 
        firstButton.addEventListener('click', function () {
          currentPage = 1;
          renderPagination(totalData, currentPage, maxPages,itemsPerPage,ubah_table, tabs );
        });
    
        pagination.appendChild(firstButton);
      }
    
      if (currentPage > 1) {
        const prevButton = document.createElement('button');
    
        prevButton.textContent = 'Previous';
    
        prevButton.addEventListener('click', function () {
          currentPage -= 1;
          renderPagination(totalData, currentPage, maxPages,itemsPerPage,ubah_table, tabs );
        });
        prevButton.onclick = function () {
            ubah_table(currentPage)
        } 
        pagination.appendChild(prevButton);
      }
    
      for (let i = 1; i <= totalPages; i++) {
        if (i === currentPage || i === 1 || i === totalPages || (i >= currentPage - maxPages && i <= currentPage + maxPages)) {
          addPageButton(i);
        } else if (i === currentPage - maxPages - 1 || i === currentPage + maxPages + 1) {
          addEllipsis();
        }
      }
    
      if (currentPage < totalPages) {
        const nextButton = document.createElement('button');
    
        nextButton.textContent = 'Next';
    
        nextButton.addEventListener('click', function () {
          currentPage += 1;
          renderPagination(totalData, currentPage, maxPages,itemsPerPage,ubah_table, tabs );
        });
        nextButton.onclick = function () {
            ubah_table( currentPage)
        } 
        pagination.appendChild(nextButton);
      }
    
      if (currentPage < totalPages) {
        const lastButton = document.createElement('button');
    
        lastButton.textContent = 'Last';
        lastButton.onclick = function () {
            ubah_table(totalPages)
        } 
        lastButton.addEventListener('click', function () {
          currentPage = totalPages;
          renderPagination(totalData, currentPage, maxPages,itemsPerPage,ubah_table, tabs );
        });
    
        pagination.appendChild(lastButton);
      }
    }
   function make_date(date,tipe) {
    const dateObject = new Date(date);

    const day = String(dateObject.getUTCDate()).padStart(2, '0');
    const month = String(dateObject.getUTCMonth() + 1).padStart(2, '0'); // getUTCMonth() mengembalikan bulan dari 0-11
    const year = dateObject.getUTCFullYear();

    const formattedDate = `${day}-${month}-${year}`;
    const formattedDate2 = `${year}-${month}-${day}`;

    return tipe ==1?formattedDate:formattedDate2
   }
   function formatNumber(num) {
      return num.toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.')
    }
