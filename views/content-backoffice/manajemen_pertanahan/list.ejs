<% include ../../template-backoffice/header.ejs %>
<!-- Main Content -->
<div class="main-content">
  <section class="section">
    <div class="w-100" style="padding: 0 30px;">
      <div class="section-header">
        <h1>Data Pertanahan</h1>
        <div class="section-header-breadcrumb">
          <div class="breadcrumb-item active"><a href="#">Dashboard</a></div>
          <div class="breadcrumb-item">Data</div>
        </div>
      </div>
    </div>

    <div class="section-body">
      <div class="row">
        <div class="col-lg-12 col-xl-12">
          <div class="card">
            <div class="card-header">
              <ul class="list-inline">
                <li class="list-inline-item">
                   <a href="/manajemen_pertanahan/insert" class="btn btn-primary custom-btn-card-header">
                    <i class="fas fa-plus"></i> Tambah Data
                  </a>
                </li>
                <li class="list-inline-item">
                  <a href="/manajemen_pertanahan/import_data" class="btn btn-dark custom-btn-card-header"><i class="fas fa-plus"></i> Import Data Spasial</a>
                </li>
              </ul>
             
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-bordered" id="list-data">
                  <thead>                                 
                    <tr>
                      <th class="text-center">No.</th>
                      <th>Nama Penguasaan</th>
                      <th>Alamat Sesuai KTP</th>
                      <th>Kecamatan</th>
                      <th>Kelurahan</th>
                      <th>Luas Tanah</th>
                      <th>Luas Bangunan</th>
                      <th>NOP</th>
                      <th>Opsi</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<footer class="main-footer">
  <div class="footer-left">
    <% include ../../template-backoffice/copyright-left.ejs %>
  </div>
  <div class="footer-right">
    <% include ../../template-backoffice/copyright-right.ejs %>
  </div>
</footer>
<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
  var rooturl = '';
let data_table2 = $('#list-data').DataTable({
    "language": {
        "sProcessing": "Sedang memproses...",
        "sLengthMenu": "_MENU_",
        "sZeroRecords": "Tidak ditemukan data yang sesuai",
        "sInfo": "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
        "sInfoEmpty": "Menampilkan 0 sampai 0 dari 0 entri",
        "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
        "sInfoPostFix": "",
        "sUrl": "",
        "oPaginate": {
            "sFirst": "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext": "Selanjutnya",
            "sLast": "Terakhir"
        }
    },
    "processing": true,
    "serverSide": true,
    "ajax": {
        "url": `${rooturl}/manajemen_pertanahan/list`,
        "type": "POST",
        "data": function(d) {
            // Mengirim parameter yang diperlukan untuk server-side processing
            // DataTables sudah mengirim draw, start, length, search, order secara otomatis
            // Tapi kita bisa menambahkan parameter tambahan jika perlu
            d.jenis = $('#jenis_filter').val(); // Contoh tambahan parameter
            return d;
        },
        "dataSrc": function(json) {
            // Jika ada error dari server
            if (json.error) {
                console.error('Server error:', json.error);
                return [];
            }
            return json.data;
        }
    },
    "columns": [
        { "data": null, "width": "30px" },
        { "data": "nm_pnguasa" },
        { "data": "almt_ktp" },
        { "data": "kecamatan" },
        { "data": "kelurahan_desa" },
        { "data": "l_tanah" },
        { "data": "l_bangunan" },
        { "data": "nop" },
        { 
            "data": null,
            "className": "text-center",
            "orderable": false,
            "render": function(data, type, row) {
                return `<ul class="list-inline mb-0">
                    <li class="list-inline-item">
                        <a href="${rooturl}/manajemen_pertanahan/edit/${row.id}" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i>
                        </a>
                    </li>
                    <li class="list-inline-item">
                        <button onclick="hapus(${row.id})" class="btn btn-danger btn-sm">
                            <i class="fa fa-trash"></i>
                        </button>
                    </li>
                </ul>`;
            }
        }
    ],
    "columnDefs": [
        { "width": "30px", "targets": 0 },
        { "orderable": false, "targets": [0, 8] } // Disable sorting untuk kolom action dan nomor
    ],
    "order": [[1, 'asc']], // Default sorting by nm_pnguasa
    "drawCallback": function(settings) {
        // Update nomor urut setelah draw
        let api = this.api();
        let start = api.page.info().start;
        api.column(0, { page: 'current' }).nodes().each(function(cell, i) {
            cell.innerHTML = start + i + 1;
        });
    }
});

// Optional: Function untuk reload data dengan parameter tambahan
function reloadDataTable() {
    data_table2.ajax.reload();
}

// Optional: Function untuk filter
function applyFilter() {
    data_table2.ajax.reload();
}
 async function hapus(id) {

    
    if (confirm("Apakah anda akan menghapus data ini?")) {
      $.get(rooturl + "/manajemen_pertanahan/hapus/" + id)
        .done(function(response) {
          if (response.status === 'success') {
           alert("Data berhasil dihapus")
            $('#list-data').DataTable().ajax.reload();
          } else {
            alert("Terjadi kesalahan")
          }
        })
        .fail(function() {
          alert("Terjadi kesalahan pada server")
        });
    }
  }
</script>