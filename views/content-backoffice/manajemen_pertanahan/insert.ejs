<% include ../../template-backoffice/header.ejs %>
  <div class="main-content">
    <section class="section">
      <div class="w-100" style="padding: 0 30px;">
        <div class="section-header" style="border-radius: 0.25rem;">
          <h1>Tambah Data Pertanahan</h1>
          <div class="section-header-breadcrumb">
            <div class="breadcrumb-item active"><a href="/backoffice">Dashboard</a></div>
            <div class="breadcrumb-item active"><a href="/manajemen_pertanahan">Data</a></div>
            <div class="breadcrumb-item">Tambah Data</div>
          </div>
        </div>
      </div>

      <% include ./komponen.ejs %>

    </section>
  </div>

  <footer class="main-footer">
    <div class="footer-left">
      <% include ../../template-backoffice/copyright-left.ejs %>
    </div>
    <div class="footer-right">
      <% include ../../template-backoffice/copyright-right.ejs %>
    </div>
  </footer>

<% include ../../template-backoffice/footer.ejs %>

<script type="text/javascript">
  var rooturl = ''; // sesuaikan jika perlu, misal '/myapp'

  document.addEventListener('DOMContentLoaded', function () {
    // ----- FITUR TAMBAH & HAPUS KOORDINAT (tetap) -----
    const container = document.getElementById('koordinat-container');
    const btnTambah = document.getElementById('btn-tambah');

    if (btnTambah) {
      btnTambah.addEventListener('click', function () {
        const barisBaru = document.createElement('div');
        barisBaru.className = 'row mt-3 koordinat-row';
        barisBaru.innerHTML = `
          <div class="col-12 col-lg-5">
            <input type="text" class="form-control" name="latitude[]" placeholder="Latitude" required>
          </div>
          <div class="col-12 col-lg-5">
            <input type="text" class="form-control" name="longitude[]" placeholder="Longitude" required>
          </div>
          <div class="col-12 col-lg-2">
            <button type="button" class="btn btn-danger btn-hapus"><i class="fas fa-trash"></i></button>
          </div>
        `;
        container.appendChild(barisBaru);
      });
    }

    if (container) {
      container.addEventListener('click', function (e) {
        const btnHapus = e.target.closest('.btn-hapus');
        if (btnHapus) {
          const baris = btnHapus.closest('.koordinat-row');
          if (baris) baris.remove();
        }
      });
    }

    // ----- SUBMIT FORM DENGAN AJAX (perbaikan id form) -----
    const form = document.getElementById('formPertanahan'); // id sudah ditambahkan di komponen.ejs
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        const willInsert = await swal({
          title: "Tambah Data",
          text: "Apakah anda akan menambahkan data ini?",
          icon: "warning",
          dangerMode: true,
          buttons: ["Tidak", "Ya"],
        });

        if (!willInsert) return;

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = 'Menyimpan...';
        }

        const formData = new FormData(form);

        $.ajax({
          type: 'POST',
          url: rooturl + '/manajemen_pertanahan/insert', // pastikan sesuai route backend
          data: formData,
          processData: false,
          contentType: false,
          success: function (data) {
            swal({
              title: 'Berhasil',
              text: 'Data berhasil ditambahkan',
              icon: 'success'
            });
            window.location.href = rooturl + '/manajemen_pertanahan';
          },
          error: function (xhr, status, error) {
            let msg = 'Terjadi kesalahan saat menyimpan data.';
            if (xhr.responseJSON && xhr.responseJSON.message) {
              msg = xhr.responseJSON.message;
            }
            swal({
              title: 'Gagal',
              text: msg,
              icon: 'error'
            });
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = 'Simpan';
            }
          }
        });
      });
    }
  });
</script>