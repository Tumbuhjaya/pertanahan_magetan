<script type="text/javascript">
  var rooturl = '';

  $( "#kd_kec" ).change(function() {
    $("#kd_kel").empty();
    $('#kd_kel').select2();
    if($('#kd_kec').val()!=""){
      $.get( "/manajemen_pertanahan/get_kel/"+$('#kd_kec').val(), function( data ) {
        console.log(data);
        $("#kd_kel").html('<option value="">--- Pilih Kelurahan ---</option>');
        $.each(data.data, function(i, item){
          $("#kd_kel").append('<option value="'+item.id_desa+'">'+item.namobj+'</option>');
        })  
      });
    }
  });

  document.addEventListener('DOMContentLoaded', function () {
    // ----- FITUR TAMBAH & HAPUS KOORDINAT -----
    const container = document.getElementById('koordinat-container');
    const btnTambah = document.getElementById('btn-tambah');

    if (btnTambah) {
      btnTambah.addEventListener('click', function () {
        const barisBaru = document.createElement('div');
        barisBaru.className = 'row mt-3 koordinat-row';
        barisBaru.innerHTML = `
          <div class="col-12 col-lg-5">
            <input type="text" class="form-control" name="x[]" placeholder="Koordinat X" required>
          </div>
          <div class="col-12 col-lg-5">
            <input type="text" class="form-control" name="y[]" placeholder="Koordinat Y" required>
          </div>
          <div class="col-12 col-lg-2">
            <button type="button" class="btn btn-danger btn-hapus"><i class="fas fa-trash"></i></button>
          </div>
        `;
        container.appendChild(barisBaru);
      });
    }

    if (container) {
      container.addEventListener('click', function (e) {
        const btnHapus = e.target.closest('.btn-hapus');
        if (btnHapus) {
          const baris = btnHapus.closest('.koordinat-row');
          if (baris) baris.remove();
        }
      });
    }

    // ----- SUBMIT FORM DENGAN AJAX -----
    const form = document.getElementById('formPertanahan');
    console.log(form);
    
    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        const willInsert = await swal({
          title: "Tambah Data",
          text: "Apakah anda akan menambahkan data ini?",
          icon: "warning",
          dangerMode: true,
          buttons: ["Tidak", "Ya"],
        });

        if (!willInsert) return;
const submitBtn = form.querySelector('button[type="submit"]');
if (submitBtn) {
  submitBtn.disabled = true;
  submitBtn.innerHTML = 'Menyimpan...';
}

// Ambil data text dari form
const formData = new FormData(form);
const dataObject = {};

// Ambil semua field text (bukan file)
for (let [key, value] of formData.entries()) {
  // Skip file inputs
  const input = form.querySelector(`[name="${key}"]`);
  if (input && input.type === 'file') {
    continue;
  }
  
  if (dataObject.hasOwnProperty(key)) {
    if (Array.isArray(dataObject[key])) {
      dataObject[key].push(value);
    } else {
      dataObject[key] = [dataObject[key], value];
    }
  } else {
    dataObject[key] = value;
  }
}

// Kirim data sebagai JSON
$.ajax({
  type: 'POST',
  url: rooturl + '/manajemen_pertanahan/submit_insert',
  data: JSON.stringify(dataObject),
  contentType: 'application/json',
  processData: false,
  success: function (data) {
    swal({
      title: 'Berhasil',
      text: 'Data berhasil ditambahkan',
      icon: 'success'
    });
    window.location.href = rooturl + '/manajemen_pertanahan';
  },
  error: function (xhr, status, error) {
    let msg = 'Terjadi kesalahan saat menyimpan data.';
    if (xhr.responseJSON && xhr.responseJSON.message) {
      msg = xhr.responseJSON.message;
    }
    swal({
      title: 'Gagal',
      text: msg,
      icon: 'error'
    });
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Simpan';
    }
  }
});
});

    }
  });

  // ============================================
  // FUNGSI KOORDINAT KE WKT & SEBALIKNYA
  // ============================================

  // Fungsi untuk mengubah koordinat dari tabel ke WKT Polygon
  function koordinatKeWKT() {
    var inputan_koordinat = "";
    var end_koordinat = "";
    var count = 0;
    
    $('.koordinat-row').each(function(index) {
      var x = $(this).find('input[name="x[]"]').val();
      var y = $(this).find('input[name="y[]"]').val();
      
      if (x && y && x.trim() !== '' && y.trim() !== '') {
        count++;
        if (inputan_koordinat === "") {
          end_koordinat = x.trim() + ' ' + y.trim();
        }
        inputan_koordinat = inputan_koordinat + x.trim() + ' ' + y.trim() + ',';
      }
    });

    if (count >= 3) {
      inputan_koordinat = inputan_koordinat + end_koordinat;
      return 'POLYGON((' + inputan_koordinat + '))';
    }
    return null;
  }

  // Fungsi untuk mengisi koordinat dari WKT Polygon
  function wktKeKoordinat(wktString) {
    if (!wktString) return;
    
    try {
      // Bersihkan string WKT
      var clean = wktString.replace(/^POLYGON\s*\(\(/, '').replace(/\)\)\s*$/, '');
      var points = clean.split(',');
      
      // Hapus titik terakhir jika sama dengan titik pertama (penutup polygon)
      if (points.length > 1) {
        var first = points[0].trim();
        var last = points[points.length - 1].trim();
        if (first === last) {
          points.pop();
        }
      }
      
      // Kosongkan container koordinat
      var container = document.getElementById('koordinat-container');
      container.innerHTML = '';
      
      // Tambahkan setiap titik
      points.forEach(function(point, index) {
        var coords = point.trim().split(' ');
        var x = coords[0] || '';
        var y = coords[1] || '';
        
        var baris = document.createElement('div');
        baris.className = 'row mt-3 koordinat-row';
        
        if (index === 0) {
          // Baris pertama tanpa tombol hapus
          baris.innerHTML = `
            <div class="col-12 col-lg-5">
              <input type="text" class="form-control" name="x[]" value="${x}" placeholder="Koordinat X" required>
            </div>
            <div class="col-12 col-lg-5">
              <input type="text" class="form-control" name="y[]" value="${y}" placeholder="Koordinat Y" required>
            </div>
            <div class="col-12 col-lg-2">
              <!-- kosong -->
            </div>
          `;
        } else {
          baris.innerHTML = `
            <div class="col-12 col-lg-5">
              <input type="text" class="form-control" name="x[]" value="${x}" placeholder="Koordinat X" required>
            </div>
            <div class="col-12 col-lg-5">
              <input type="text" class="form-control" name="y[]" value="${y}" placeholder="Koordinat Y" required>
            </div>
            <div class="col-12 col-lg-2">
              <button type="button" class="btn btn-danger btn-hapus"><i class="fas fa-trash"></i></button>
            </div>
          `;
        }
        
        container.appendChild(baris);
      });
      
      // Re-attach event listener untuk tombol hapus
      container.addEventListener('click', function (e) {
        const btnHapus = e.target.closest('.btn-hapus');
        if (btnHapus) {
          const baris = btnHapus.closest('.koordinat-row');
          if (baris) baris.remove();
        }
      });
      
    } catch(e) {
      console.error('Error parsing WKT:', e);
    }
  }

  // ============================================
  // FUNGSI PETA
  // ============================================

  function toWKT(layer) {
    var lng, lat, coords = [];
    if (layer instanceof L.Polygon || layer instanceof L.Polyline) {
      var latlngs = layer.getLatLngs();
      for (var i = 0; i < latlngs.length; i++) {
        var latlngs1 = latlngs[i];
        if (latlngs1.length) {
          for (var j = 0; j < latlngs1.length; j++) {
            coords.push(latlngs1[j].lng + " " + latlngs1[j].lat);
            if (j === 0) {
              lng = latlngs1[j].lng;
              lat = latlngs1[j].lat;
            }
          }
        } else {
          coords.push(latlngs[i].lng + " " + latlngs[i].lat);
          if (i === 0) {
            lng = latlngs[i].lng;
            lat = latlngs[i].lat;
          }
        }
      }
      if (layer instanceof L.Polygon) {
        return "POLYGON((" + coords.join(",") + "," + lng + " " + lat + "))";
      } else if (layer instanceof L.Polyline) {
        return "LINESTRING(" + coords.join(",") + ")";
      }
    } else if (layer instanceof L.Marker) {
      return "POINT(" + layer.getLatLng().lng + " " + layer.getLatLng().lat + ")";
    }
    return null;
  }

  function peta_pemohon(wktString) {
    if (!wktString) return;
    
    drawnItems.clearLayers();
    $('#SHAPE').val(wktString);
    
    try {
      var layer_parse = omnivore.wkt.parse(wktString);
      
      layer_parse.eachLayer(function(layer) {
        if (layer.feature.geometry.type !== "Point") {
          var bounds = layer.getBounds();
          if (bounds && bounds.isValid()) {
            map.fitBounds(bounds);
          }
        }
        drawnItems.addLayer(layer);
      });
      
      // Update koordinat di form dari WKT
      wktKeKoordinat(wktString);
      
    } catch(e) {
      console.error('Error parsing WKT:', e);
    }
  }

  // ============================================
  // INISIALISASI MAP
  // ============================================

  var southWest = L.latLng(-7.7228245, 111.2106116);
  var northEast = L.latLng(-7.5578955, 111.3991254);
  var bounds = L.latLngBounds(southWest, northEast);
  
  var map = L.map('map', {
    center: [-7.653612465060216, 111.32634662536874],
    zoom: 12,
    minZoom: 2,
    maxZoom: 15,
    fullscreenControl: true,
    fullscreenControlOptions: {
      position: 'topleft'
    }
  });

  // Base Layers
  var google_hybrid = L.gridLayer.googleMutant({
    type: 'hybrid'
  });
  
  var google_roadmap = L.gridLayer.googleMutant({
    type: 'roadmap'
  });
  
  var google_satelit = L.gridLayer.googleMutant({
    type: 'satellite'
  });
  
  var osm = L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', {});
  var Esri_WorldImagery = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}');
  
  var RBI = L.esri.tiledMapLayer({
    url: "https://portal.ina-sdi.or.id/arcgis/rest/services/IGD/RupabumiIndonesia/MapServer"
  });

  // Fix tile overlap
  (function() {
    var originalInitTile = L.GridLayer.prototype._initTile;
    L.GridLayer.include({
      _initTile: function(tile) {
        originalInitTile.call(this, tile);
        var tileSize = this.getTileSize();
        tile.style.width = tileSize.x + 1 + 'px';
        tile.style.height = tileSize.y + 1 + 'px';
      }
    });
  })();

  map.addLayer(google_hybrid);

  // ============================================
  // DRAW CONTROL UNTUK DIGITASI
  // ============================================

  var drawnItems = L.featureGroup().addTo(map);
  
  var options = {
    position: 'topleft',
    draw: {
      polyline: true,
      polygon: {
        allowIntersection: false,
        drawError: {
          color: '#e1e100',
          message: '<strong>Digitasi Salah!</strong>'
        },
        shapeOptions: {
          color: '#bada55'
        }
      },
      circle: false,
      rectangle: false,
      marker: false
    },
    edit: {
      featureGroup: drawnItems,
      remove: true
    }
  };

  var drawControl = new L.Control.Draw(options);
  map.addControl(drawControl);

  // Event saat polygon digambar
  map.on(L.Draw.Event.CREATED, function(event) {
    drawnItems.clearLayers();
    var layer = event.layer;
    drawnItems.addLayer(layer);
    
    var wkt = toWKT(layer);
    if (wkt) {
      $('#SHAPE').val(wkt);
      // Isi koordinat dari WKT ke form
      wktKeKoordinat(wkt);
      
      // Zoom ke polygon
      var bounds = layer.getBounds();
      if (bounds && bounds.isValid()) {
        map.fitBounds(bounds);
      }
    }
  });

  // Event saat polygon diedit
  map.on(L.Draw.Event.EDITED, function(event) {
    var layers = event.layers;
    layers.eachLayer(function(layer) {
      var wkt = toWKT(layer);
      if (wkt) {
        $('#SHAPE').val(wkt);
        wktKeKoordinat(wkt);
      }
    });
  });

  // Event saat polygon dihapus
  map.on(L.Draw.Event.DELETED, function(event) {
    $('#SHAPE').val('');
    $('#koordinat-container').html('');
    // Tambahkan baris kosong
    var container = document.getElementById('koordinat-container');
    var baris = document.createElement('div');
    baris.className = 'row mt-3 koordinat-row';
    baris.innerHTML = `
      <div class="col-12 col-lg-5">
        <input type="text" class="form-control" name="x[]" placeholder="Koordinat X" required>
      </div>
      <div class="col-12 col-lg-5">
        <input type="text" class="form-control" name="y[]" placeholder="Koordinat Y" required>
      </div>
      <div class="col-12 col-lg-2">
        <!-- kosong -->
      </div>
    `;
    container.appendChild(baris);
  });

  // ============================================
  // TOMBOL GAMBAR PETA (dari koordinat ke peta)
  // ============================================

  $(document).ready(function() {
    // Fungsi untuk tombol Gambar Peta
    $('#parsepeta').on("click", function() {
      var wkt = koordinatKeWKT();
      if (wkt) {
        peta_pemohon(wkt);
      } else {
        swal({
          title: 'Peringatan',
          text: 'Masukkan minimal 3 titik koordinat yang valid terlebih dahulu!',
          icon: 'warning'
        });
      }
    });

    // Tombol Reset Peta
    $('#reset_peta').on("click", function() {
      drawnItems.clearLayers();
      $('#SHAPE').val('');
      $('#koordinat-container').html('');
      
      // Tambahkan baris kosong
      var container = document.getElementById('koordinat-container');
      var baris = document.createElement('div');
      baris.className = 'row mt-3 koordinat-row';
      baris.innerHTML = `
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="x[]" placeholder="Koordinat X" required>
        </div>
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="y[]" placeholder="Koordinat Y" required>
        </div>
        <div class="col-12 col-lg-2">
          <!-- kosong -->
        </div>
      `;
      container.appendChild(baris);
      
      // Kembalikan view ke awal
      map.setView([-7.653612465060216, 111.32634662536874], 12);
    });

    // Tombol Tambah Koordinat
    $('#addrow').on("click", function() {
      var container = document.getElementById('koordinat-container');
      var barisBaru = document.createElement('div');
      barisBaru.className = 'row mt-3 koordinat-row';
      barisBaru.innerHTML = `
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="x[]" placeholder="Koordinat X" required>
        </div>
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="y[]" placeholder="Koordinat Y" required>
        </div>
        <div class="col-12 col-lg-2">
          <button type="button" class="btn btn-danger btn-hapus"><i class="fas fa-trash"></i></button>
        </div>
      `;
      container.appendChild(barisBaru);
    });

    // Hapus baris koordinat
    $(document).on('click', '.btn-hapus', function() {
      var row = $(this).closest('.koordinat-row');
      if (row && $('.koordinat-row').length > 1) {
        row.remove();
      } else {
        swal({
          title: 'Peringatan',
          text: 'Minimal harus ada 1 baris koordinat!',
          icon: 'warning'
        });
      }
    });
  });

  // ============================================
  // LOAD KECAMATAN & KABUPATEN (menggunakan L.GeoJSON)
  // ============================================

  var kabupaten_layer = new L.GeoJSON();
  var desa_layer = new L.GeoJSON();
  var rdtr_layer = new L.GeoJSON();
  var kabmagetan_layer = new L.GeoJSON();
  var popup = new L.popup();

  var style_kabupaten = {
    color: "yellow",
    weight: 3,
    opacity: 1,
    fillOpacity: 0,
    dashArray: 3
  };

  var style_desa = {
    color: "white",
    weight: 1,
    opacity: 1,
    fillOpacity: 0,
    dashArray: 3
  };

  var label_kec = [];
  var label_desa = [];

  // Fungsi untuk konversi TopoJSON ke GeoJSON
  function topojsonToGeojson(data) {
    if (data.type === "Topology") {
      var geojson = {
        type: "FeatureCollection",
        features: []
      };
      for (var key in data.objects) {
        var feature = topojson.feature(data, data.objects[key]);
        if (feature.features) {
          geojson.features = geojson.features.concat(feature.features);
        } else {
          geojson.features.push(feature);
        }
      }
      return geojson;
    }
    return data;
  }

  function loadGeoJsonkec(data) {
    var geojsonData = topojsonToGeojson(data);
    kabupaten_layer.clearLayers();
    kabupaten_layer.addData(geojsonData);
    kabupaten_layer.addTo(map);
    
    var i = 0;
    kabupaten_layer.eachLayer(function(layer) {
      layer.setStyle(style_kabupaten);
      var bounds = layer.getBounds();
      if (bounds && bounds.isValid()) {
        var center = bounds.getCenter();
        
        label_kec[i] = new L.Tooltip({
          noHide: false,
          direction: 'auto',
          permanent: true
        });
        
        var labelText = layer.feature.properties.kab || layer.feature.properties.kecamatan || '';
        label_kec[i].setContent(labelText);
        label_kec[i].setLatLng(center);
        map.showLabel(label_kec[i]);
        i++;
      }
    });
    
    hide_label_kec();

    // Zoom ke seluruh kecamatan
    if (kabupaten_layer.getLayers().length > 0) {
      var bounds = kabupaten_layer.getBounds();
      if (bounds && bounds.isValid()) {
        map.fitBounds(bounds, {
          padding: [20, 20],
          maxZoom: 12
        });
      }
    }
  }

  function loadGeoJsondesa(data) {
    var geojsonData = topojsonToGeojson(data);
    hapus_label_desa();
    desa_layer.clearLayers();
    desa_layer.addData(geojsonData);
    desa_layer.addTo(map);
    
    var i = 0;
    desa_layer.eachLayer(function(layer) {
      layer.setStyle(style_desa);
      var bounds = layer.getBounds();
      if (bounds && bounds.isValid()) {
        var center = bounds.getCenter();
        
        label_desa[i] = new L.Tooltip({
          noHide: false,
          direction: 'auto',
          permanent: true
        });
        
        var labelText = layer.feature.properties.desa || layer.feature.properties.namobj || '';
        label_desa[i].setContent(labelText);
        label_desa[i].setLatLng(center);
        label_desa[i].setOpacity(0);
        map.showLabel(label_desa[i]);
        i++;
      }
    });
    
    tampil_label_desa();
    map.removeLayer(drawnItems);
    drawnItems.addTo(map);
  }

  function loadRdtr(data) {
    var geojsonData = topojsonToGeojson(data);
    rdtr_layer.clearLayers();
    rdtr_layer.addData(geojsonData);
    rdtr_layer.addTo(map);
    rdtr_layer.eachLayer(function(layer) {
      layer.setStyle({
        color: '#ff7800',
        weight: 2,
        opacity: 0.8,
        fillOpacity: 0.3,
        fillColor: '#ff7800'
      });
      var props = layer.feature.properties;
      var popupContent = '<b>Nama:</b> ' + (props.namobj || '') +
                         '<br><b>Kode Sub Z:</b> ' + (props.kode_sub_z || '');
      layer.bindPopup(popupContent);
    });
  }

  function loadKabmagetan(data) {
    var geojsonData = topojsonToGeojson(data);
    kabmagetan_layer.clearLayers();
    kabmagetan_layer.addData(geojsonData);
    kabmagetan_layer.addTo(map);
    kabmagetan_layer.eachLayer(function(layer) {
      layer.setStyle({
        color: '#3388ff',
        weight: 2,
        opacity: 0.8,
        fillOpacity: 0.3,
        fillColor: '#3388ff'
      });
      var props = layer.feature.properties;
      var popupContent = '<b>Nama:</b> ' + (props.namobj || '');
      layer.bindPopup(popupContent);
    });
  }

  function hapus_label_kec() {
    for (var i = 0; i < label_kec.length; i++) {
      if (label_kec[i]) {
        map.removeLayer(label_kec[i]);
      }
    }
    label_kec = [];
  }

  function tampil_label_kec() {
    for (var i = 0; i < label_kec.length; i++) {
      if (label_kec[i]) {
        label_kec[i].setOpacity(1);
      }
    }
  }

  function hide_label_kec() {
    for (var i = 0; i < label_kec.length; i++) {
      if (label_kec[i]) {
        label_kec[i].setOpacity(0);
      }
    }
  }

  function hapus_label_desa() {
    for (var i = 0; i < label_desa.length; i++) {
      if (label_desa[i]) {
        map.removeLayer(label_desa[i]);
      }
    }
    label_desa = [];
  }

  function tampil_label_desa() {
    for (var i = 0; i < label_desa.length; i++) {
      if (label_desa[i]) {
        label_desa[i].setOpacity(1);
      }
    }
  }

  function hide_label_desa() {
    for (var i = 0; i < label_desa.length; i++) {
      if (label_desa[i]) {
        label_desa[i].setOpacity(0);
      }
    }
  }

  // Load data
  $.getJSON(rooturl + "/peta/topojson_kec").done(loadGeoJsonkec);
  
  $.getJSON(rooturl + "/peta/topojson_rdtr")
    .done(loadRdtr)
    .fail(function(jqXHR, textStatus, errorThrown) {
      console.error('Gagal load RDTR:', textStatus, errorThrown);
    });
    
  $.getJSON(rooturl + "/peta/topojson_kabmagetan")
    .done(loadKabmagetan)
    .fail(function(jqXHR, textStatus, errorThrown) {
      console.error('Gagal load Kab Magetan:', textStatus, errorThrown);
    });

  // Moveend event untuk label
  var wellmaxzoom = 13;
  
  map.on('moveend', function() {
    if (map.getZoom() > 9) {
      tampil_label_kec();
    } else {
      hide_label_kec();
    }
    
    if (map.getZoom() > wellmaxzoom) {
      var kiri_atas_lng = map.getBounds().getSouthWest().lng;
      var kiri_atas_lat = map.getBounds().getSouthWest().lat;
      var kanan_bawah_lng = map.getBounds().getNorthEast().lng;
      var kanan_bawah_lat = map.getBounds().getNorthEast().lat;
      
      var geoJsonUrl = rooturl + "peta/topojson_desa?kiri_lng=" + kiri_atas_lng + 
                       "&kiri_lat=" + kiri_atas_lat + 
                       "&kanan_lng=" + kanan_bawah_lng + 
                       "&kanan_lat=" + kanan_bawah_lat;
      
      $.getJSON(geoJsonUrl).done(loadGeoJsondesa);
    } else {
      hapus_label_desa();
      map.removeLayer(desa_layer);
    }
  });

  // ============================================
  // LAYER CONTROL
  // ============================================

  var baseLayers = {
    "Google Roadmap": google_roadmap,
    "Google Hybrid": google_hybrid,
    "Google Satellite": google_satelit,
    "Open Street Map": osm,
    "ESRI World Imagery": Esri_WorldImagery,
    "RBI": RBI
  };

  var groupedOverlays = {
    "Administrasi": {
      "&nbsp;&nbsp;Kabupaten": kabupaten_layer
    },
    "Layer": {
      "<span>&nbsp;&nbsp;RDTR Karangrejo</span>&nbsp;&nbsp;<span style='background-color:#ff7800;padding:2px 8px 2px 8px;'></span>": rdtr_layer,
      "<span>&nbsp;&nbsp;Pola Ruang Kab Magetan</span>&nbsp;&nbsp;<span style='background-color:#3388ff;padding:2px 8px 2px 8px;'></span>": kabmagetan_layer
    }
  };

  var options = {
    collapsed: true,
    groupCheckboxes: false
  };

  L.control.groupedLayers(baseLayers, groupedOverlays, options).addTo(map);

  // Scale control
  L.control.scale({
    position: 'bottomright',
    metric: true,
    imperial: false
  }).addTo(map);

  // Legend
  var legend = L.control({ position: 'bottomleft' });
  legend.onAdd = function(map) {
    var div = L.DomUtil.create('div', 'info-legend');
    div.innerHTML = '<i style="background:#bada55;"></i> Digitasi Peta';
    return div;
  };
  legend.addTo(map);

  // Map click handler
  map.on('click', function(e) {
    console.log(e.latlng.lat + ' ' + e.latlng.lng);
    $('#xe').val(e.latlng.lng);
    $('#ye').val(e.latlng.lat);
  });

  // Fungsi untuk mendapatkan koordinat dari klik di peta
  function clickHandler(e) {
    $('#xe').val(e.latlng.lng);
    $('#ye').val(e.latlng.lat);
  }
</script>