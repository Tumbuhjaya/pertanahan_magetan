<div class="section-body">
  <div class="row">
    <div class="col-12 col-lg-12 col-xl-12">
      <div class="card">
        <div class="card-body">
          <form  id="formPertanahan">
            <input type="hidden" name="SHAPE" id="SHAPE">
            
            <div class="form-group row">
              <div class="col-12">
                <h5><strong>DIGITASI PETA</strong></h5>
                <hr>
              </div>

              <div class="col-12 col-lg-7 col-xl-7">
                <div class="w-100" style="height: 500px;background-color: whitesmoke;" id="map"></div>
              </div>
              
              <div class="col-12 col-lg-5 col-xl-5">
                <div class="row">
                  <div class="col-12">
                    <div id="koordinat-container">
                      <div class="row mt-3 koordinat-row">
                        <div class="col-12 col-lg-5">
                          <input type="text" class="form-control" name="" id="latitude" placeholder="Koordinat X" required>
                        </div>
                        <div class="col-12 col-lg-5">
                          <input type="text" class="form-control" name="" id="longitude" placeholder="Koordinat Y" required>
                        </div>
                        <div class="col-12 col-lg-2">
                          <!-- kosong -->
                        </div>
                      </div>
                    </div>

                    <div class="row">
                      <div class="col-12">
                        <hr>
                        <ul class="list-inline">
                          <li class="list-inline-item">
                            <button type="button" id="addrow" class="btn btn-dark">
                              <i class="fas fa-plus"></i> Tambah Koordinat 
                            </button>
                          </li>
                          <li class="list-inline-item">
                            <button type="button" id="parsepeta" class="btn btn-primary">
                              <i class="fas fa-pencil-ruler"></i> Gambar Peta
                            </button>
                          </li>
                          <li class="list-inline-item">
                            <button type="button" id="reset_peta" class="btn btn-warning">
                              <i class="fas fa-undo-alt"></i> Reset Peta
                            </button>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- INFORMASI UMUM -->
            <div class="form-group row">
              <div class="col-12">
                <h5><strong>INFORMASI UMUM</strong></h5>
                <hr>
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Nama Penguasaan</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="nm_pnguasa" id="nama_penguasaan">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">NIK</label>
              <div class="col-sm-10">
                <input type="number" class="form-control" name="nik" id="nik">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">No. KK</label>
              <div class="col-sm-10">
                <input type="number" class="form-control" name="no_kk" id="no_kk">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Alamat Sesuai KTP</label>
              <div class="col-sm-10">
                <textarea name="almt_ktp" id="alamat_ktp" class="form-control" rows="1"></textarea>
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Alamat Rumah</label>
              <div class="col-sm-10">
                <textarea name="almt_rmh" id="alamat_rumah" class="form-control" rows="1"></textarea>
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Kecamatan</label>
              <div class="col-sm-10">
                <select name="kd_kec" id="kd_kec" class="form-control select2">
                  <option value="">-- Pilih --</option>
                        <% for(var i=0; i<kec.length; i++){ %> 
                                <option value="<%= kec[i]['id_kec']%>"><%= kec[i]['kecamatan']%></option>
                                 <% }%>
                </select>
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Kelurahan/Desa</label>
              <div class="col-sm-10">
                <select name="kd_kel" id="kd_kel" class="form-control select2">
                  <option value="">-- Pilih --</option>
                </select>
              </div>
            </div>

            <!-- INFORMASI TANAH -->
            <div class="form-group row">
              <div class="col-12">
                <h5><strong>INFORMASI TANAH</strong></h5>
                <hr>
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Luas Tanah (m<sup>2</sup>)</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="l_tanah" id="luas_tanah">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">No. Sertifikat</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="no_srtfkt" id="no_sertifikat">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Jenis Hak</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="jns_hak" id="jenis_hak">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">No. Hak</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="no_hak" id="no_hak">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Tahun Kepemilikan</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="th_kpmlkn" id="tahun_kepemilikan">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">NIB</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="nib" id="nib">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Batas Utara</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="bts_utr" id="batas_utara">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Batas Selatan</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="bts_sltn" id="batas_selatan">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Batas Timur</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="bts_tmr" id="batas_timur">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Batas Barat</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="bts_brt" id="batas_barat">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Zona Nilai Tanah (ZNT)</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="znt" id="znt">
              </div>
            </div>

            <!-- INFORMASI PBB -->
            <div class="form-group row">
              <div class="col-12">
                <h5><strong>INFORMASI PBB</strong></h5>
                <hr>
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Nomor Objek Pajak (NOP)</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="nop" id="nop">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Luas Bumi (m<sup>2</sup>)</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="l_bumi" id="luas_bumi">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Pajak Bumi</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="p_bumi" id="pajak_bumi">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Luas Bangunan (m<sup>2</sup>)</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="l_bangunan" id="luas_bangunan">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Pajak Bangunan</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="p_bngnan" id="pajak_bangunan">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Nilai Jual Objek Pajak (NJOP)</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="njop" id="njop">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Tagihan</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="tagihan" id="tagihan">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Tanggal Pembayaran Terakhir</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="t_pmbyran" id="tgl1">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Status Bayar</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="stts_bayar" id="status_bayar">
              </div>
            </div>

            <!-- INFORMASI TATA RUANG -->
            <div class="form-group row">
              <div class="col-12">
                <h5><strong>INFORMASI TATA RUANG</strong></h5>
                <hr>
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Pemanfaatan Lahan</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="pmftn_lhn" id="pemanfaatan_lahan">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Peruntukan Lahan</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="prntkn_lhn" id="peruntukan_lahan">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Zona Ruang</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="zn_ruang" id="zona_ruang">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Kelas Bumi</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="k_bumi" id="kelas_bumi">
              </div>
            </div>

            <div class="form-group row">
              <label class="col-sm-2 col-form-label">Kelas Bangunan</label>
              <div class="col-sm-10">
                <input type="text" class="form-control" name="k_bangunan" id="kelas_bangunan">
              </div>
            </div>

            <hr>
            <div class="form-group row">
              <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary"><i class="fas fa-check"></i> Simpan</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>