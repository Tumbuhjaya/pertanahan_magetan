  // ============================================
  // FUNGSI KOORDINAT KE WKT & SEBALIKNYA
  // ============================================

  // Fungsi untuk mengubah koordinat dari tabel ke WKT Polygon
  function koordinatKeWKT() {
    var inputan_koordinat = "";
    var end_koordinat = "";
    var count = 0;
    var firstX = "", firstY = "";
    
    $('.koordinat-row').each(function(index) {
      var x = $(this).find('input[name="x[]"]').val();
      var y = $(this).find('input[name="y[]"]').val();
      
      if (x && y && x.trim() !== '' && y.trim() !== '') {
        x = x.trim();
        y = y.trim();
        
        if (count === 0) {
          firstX = x;
          firstY = y;
          end_koordinat = x + ' ' + y;
        }
        
        count++;
        inputan_koordinat = inputan_koordinat + x + ' ' + y + ',';
      }
    });

    if (count >= 3) {
      // Tambahkan titik pertama di akhir untuk menutup polygon
      inputan_koordinat = inputan_koordinat + firstX + ' ' + firstY;
      return 'POLYGON((' + inputan_koordinat + '))';
    }
    return null;
  }

  // Fungsi untuk mengisi koordinat dari WKT Polygon
  function wktKeKoordinat(wktString) {
    if (!wktString) return;
    
    try {
      // Bersihkan string WKT
      var clean = wktString.replace(/^POLYGON\s*\(\(/, '').replace(/\)\)\s*$/, '');
      var points = clean.split(',');
      
      // Hapus titik terakhir jika sama dengan titik pertama (polygon tertutup)
      if (points.length > 1) {
        var first = points[0].trim();
        var last = points[points.length - 1].trim();
        if (first === last) {
          points.pop();
        }
      }
      
      var container = document.getElementById('koordinat-container');
      // Kosongkan container
      container.innerHTML = '';
      
      points.forEach(function(point, index) {
        var coords = point.trim().split(/\s+/);
        var x = coords[0] || '';
        var y = coords[1] || '';
        
        var baris = document.createElement('div');
        baris.className = 'row mt-3 koordinat-row';
        
        if (index === 0) {
          baris.innerHTML = `
            <div class="col-12 col-lg-5">
              <input type="text" class="form-control" name="x[]" value="${x}" placeholder="Koordinat X" required>
            </div>
            <div class="col-12 col-lg-5">
              <input type="text" class="form-control" name="y[]" value="${y}" placeholder="Koordinat Y" required>
            </div>
            <div class="col-12 col-lg-2">
              <!-- kosong -->
            </div>
          `;
        } else {
          baris.innerHTML = `
            <div class="col-12 col-lg-5">
              <input type="text" class="form-control" name="x[]" value="${x}" placeholder="Koordinat X" required>
            </div>
            <div class="col-12 col-lg-5">
              <input type="text" class="form-control" name="y[]" value="${y}" placeholder="Koordinat Y" required>
            </div>
            <div class="col-12 col-lg-2">
              <button type="button" class="btn btn-danger btn-hapus"><i class="fas fa-trash"></i></button>
            </div>
          `;
        }
        
        container.appendChild(baris);
      });
      
      // Re-attach event listener untuk tombol hapus
      container.addEventListener('click', function (e) {
        const btnHapus = e.target.closest('.btn-hapus');
        if (btnHapus) {
          const baris = btnHapus.closest('.koordinat-row');
          if (baris) baris.remove();
        }
      });
      
    } catch(e) {
      console.error('Error parsing WKT:', e);
    }
  }

  // ============================================
  // FUNGSI PETA
  // ============================================

  function toWKT(layer) {
    var lng, lat, coords = [];
    if (layer instanceof L.Polygon || layer instanceof L.Polyline) {
      var latlngs = layer.getLatLngs();
      for (var i = 0; i < latlngs.length; i++) {
        var latlngs1 = latlngs[i];
        if (latlngs1.length) {
          for (var j = 0; j < latlngs1.length; j++) {
            coords.push(latlngs1[j].lng + " " + latlngs1[j].lat);
            if (j === 0) {
              lng = latlngs1[j].lng;
              lat = latlngs1[j].lat;
            }
          }
        } else {
          coords.push(latlngs[i].lng + " " + latlngs[i].lat);
          if (i === 0) {
            lng = latlngs[i].lng;
            lat = latlngs[i].lat;
          }
        }
      }
      if (layer instanceof L.Polygon) {
        return "POLYGON((" + coords.join(",") + "," + lng + " " + lat + "))";
      } else if (layer instanceof L.Polyline) {
        return "LINESTRING(" + coords.join(",") + ")";
      }
    } else if (layer instanceof L.Marker) {
      return "POINT(" + layer.getLatLng().lng + " " + layer.getLatLng().lat + ")";
    }
    return null;
  }

function peta_pemohon(wktString) {
  console.log('=== peta_pemohon called ===');
  console.log('Input type:', typeof wktString);
  console.log('Input value:', wktString);
  
  // Validasi input
  if (!wktString) {
    console.warn('WKT string is empty or null');
    return;
  }
  
  // Jika wktString adalah array
  if (Array.isArray(wktString)) {
    console.log('Processing array format, length:', wktString.length);
    console.log('First item sample:', wktString[0]);
    
    try {
      var coordinates = [];
      
      // Cek apakah array berisi array lain di dalamnya
      if (wktString.length === 1 && Array.isArray(wktString[0])) {
        // Struktur: [[{...}, {...}, ...]]
        console.log('Detected nested array structure');
        var innerArray = wktString[0];
        wktString = innerArray; // Gunakan inner array
        console.log('Using inner array with length:', innerArray.length);
      }
      
      wktString.forEach(function(coord, index) {
        console.log(`Processing coord ${index}:`, coord);
        
        var lat = 0, lng = 0;
        
        // Cek berbagai kemungkinan format
        if (typeof coord === 'object' && coord !== null) {
          // Format: {lat: -7.123, lng: 111.123} atau {latitude: -7.123, longitude: 111.123}
          lat = coord.lat || coord.latitude || coord.y || coord.lat_y || 0;
          lng = coord.lng || coord.longitude || coord.x || coord.lng_x || 0;
          
          console.log(`  Extracted from object: lat=${lat}, lng=${lng}`);
        } else if (Array.isArray(coord)) {
          // Format: [-7.123, 111.123] atau [111.123, -7.123]
          if (coord.length >= 2) {
            // Coba deteksi urutan [lat, lng] atau [lng, lat]
            if (coord[0] >= -90 && coord[0] <= 90 && coord[1] >= -180 && coord[1] <= 180) {
              // [lat, lng]
              lat = coord[0];
              lng = coord[1];
            } else if (coord[1] >= -90 && coord[1] <= 90 && coord[0] >= -180 && coord[0] <= 180) {
              // [lng, lat]
              lat = coord[1];
              lng = coord[0];
            } else {
              lat = coord[0];
              lng = coord[1];
            }
            console.log(`  Extracted from array: lat=${lat}, lng=${lng}`);
          }
        } else if (typeof coord === 'string') {
          // Format: "-7.123,111.123" atau "-7.123 111.123"
          var parts = coord.split(/[, ]+/);
          if (parts.length >= 2) {
            lat = parseFloat(parts[0]);
            lng = parseFloat(parts[1]);
            console.log(`  Extracted from string: lat=${lat}, lng=${lng}`);
          }
        }
        
        // Konversi ke angka
        lat = parseFloat(lat);
        lng = parseFloat(lng);
        
        // Validasi koordinat: lat harus antara -90 dan 90, lng antara -180 dan 180
        if (!isNaN(lat) && !isNaN(lng) && 
            lat >= -90 && lat <= 90 && 
            lng >= -180 && lng <= 180 &&
            !(lat === 0 && lng === 0)) { // Abaikan koordinat (0,0) yang mungkin default
          console.log(`  ✅ Valid coord found: lat=${lat}, lng=${lng}`);
          coordinates.push([lat, lng]);
        } else {
          console.warn(`  ⚠️ Invalid coord at index ${index}:`, coord);
        }
      });
      
      console.log('Total valid coordinates:', coordinates.length);
      
      if (coordinates.length >= 3) {
        console.log('Creating polygon with coordinates:', coordinates);
        
        // Buat polygon
        var polygon = L.polygon(coordinates, {
          color: '#bada55',
          weight: 3,
          fillOpacity: 0.3
        });
        
        drawnItems.clearLayers();
        drawnItems.addLayer(polygon);
        map.fitBounds(polygon.getBounds());
        
        // Update SHAPE hidden field
        var wkt = koordinatArrayToWKT(coordinates);
        $('#SHAPE').val(wkt);
        
        // Update form koordinat
        updateKoordinatForm(coordinates);
        
        console.log('✅ Polygon created successfully');
        return;
      } else {
        console.error('Not enough valid coordinates:', coordinates.length);
        
        // Coba parsing dengan cara lain
        console.log('Attempting alternative parsing...');
        var altCoords = tryAlternativeParsing(wktString);
        if (altCoords && altCoords.length >= 3) {
          console.log('Alternative parsing succeeded:', altCoords.length);
          return peta_pemohon(altCoords);
        }
        
        swal({
          title: 'Error',
          text: 'Data koordinat tidak lengkap. Minimal 3 titik koordinat diperlukan.',
          icon: 'error'
        });
        return;
      }
    } catch(e) {
      console.error('Error processing array format:', e);
      return;
    }
  }
  
  // ... sisanya sama seperti sebelumnya ...
}

// Fungsi untuk alternative parsing yang lebih baik
function tryAlternativeParsing(data) {
  console.log('Attempting alternative parsing...');
  
  try {
    // Jika data adalah array
    if (Array.isArray(data)) {
      var coords = [];
      
      // Jika ada nested array, flatten
      var flatData = [];
      data.forEach(function(item) {
        if (Array.isArray(item)) {
          item.forEach(function(subItem) {
            flatData.push(subItem);
          });
        } else {
          flatData.push(item);
        }
      });
      
      console.log('Flat data:', flatData);
      
      flatData.forEach(function(item) {
        if (typeof item === 'object' && item !== null) {
          // Coba semua kemungkinan property name
          var possibleLat = ['lat', 'latitude', 'Lat', 'y', 'Y', 'lat_y', 'latY'];
          var possibleLng = ['lng', 'longitude', 'Lng', 'x', 'X', 'lng_x', 'lngX'];
          
          var lat = 0, lng = 0;
          
          for (var i = 0; i < possibleLat.length; i++) {
            if (item[possibleLat[i]] !== undefined) {
              lat = parseFloat(item[possibleLat[i]]);
              if (!isNaN(lat)) break;
            }
          }
          
          for (var j = 0; j < possibleLng.length; j++) {
            if (item[possibleLng[j]] !== undefined) {
              lng = parseFloat(item[possibleLng[j]]);
              if (!isNaN(lng)) break;
            }
          }
          
          // Jika masih 0, coba ambil dari property pertama dan kedua
          if (lat === 0 && lng === 0) {
            var keys = Object.keys(item);
            if (keys.length >= 2) {
              var firstVal = parseFloat(item[keys[0]]);
              var secondVal = parseFloat(item[keys[1]]);
              
              if (!isNaN(firstVal) && !isNaN(secondVal)) {
                if (firstVal >= -90 && firstVal <= 90 && secondVal >= -180 && secondVal <= 180) {
                  lat = firstVal;
                  lng = secondVal;
                } else if (secondVal >= -90 && secondVal <= 90 && firstVal >= -180 && firstVal <= 180) {
                  lat = secondVal;
                  lng = firstVal;
                }
              }
            }
          }
          
          if (!isNaN(lat) && !isNaN(lng) && 
              lat >= -90 && lat <= 90 && 
              lng >= -180 && lng <= 180 &&
              !(lat === 0 && lng === 0)) {
            console.log(`Alternative found valid coord: lat=${lat}, lng=${lng}`);
            coords.push([lat, lng]);
          }
        } else if (Array.isArray(item) && item.length >= 2) {
          var lat = parseFloat(item[0]);
          var lng = parseFloat(item[1]);
          if (!isNaN(lat) && !isNaN(lng) && 
              lat >= -90 && lat <= 90 && 
              lng >= -180 && lng <= 180 &&
              !(lat === 0 && lng === 0)) {
            console.log(`Alternative found valid coord from array: lat=${lat}, lng=${lng}`);
            coords.push([lat, lng]);
          }
        }
      });
      
      if (coords.length >= 3) {
        return coords;
      }
    }
  } catch(e) {
    console.error('Alternative parsing error:', e);
  }
  
  return null;
}

