        </div>
      `;
    }
    container.appendChild(baris);
  });
}
// Fungsi untuk alternative parsing
function tryAlternativeParsing(data) {
  console.log('Attempting alternative parsing...');
  
  try {
    if (Array.isArray(data) && data.length > 0) {
      var coords = [];
      
      data.forEach(function(item) {
        if (typeof item === 'object' && item !== null) {
          // Coba extract dari berbagai property
          var lat = item.lat || item.latitude || item.y || item[0] || 0;
          var lng = item.lng || item.longitude || item.x || item[1] || 0;
          
          lat = parseFloat(lat);
          lng = parseFloat(lng);
          
          if (!isNaN(lat) && !isNaN(lng)) {
            coords.push([lat, lng]);
          }
        } else if (Array.isArray(item) && item.length >= 2) {
          var lat = parseFloat(item[0]);
          var lng = parseFloat(item[1]);
          if (!isNaN(lat) && !isNaN(lng)) {
            coords.push([lat, lng]);
          }
        }
      });
      
      if (coords.length >= 3) {
        return coords;
      }
    }
  } catch(e) {
    console.error('Alternative parsing error:', e);
  }
  
  return null;
}
// Fungsi untuk mengkonversi array koordinat ke WKT
function koordinatArrayToWKT(coordinates) {
  if (!coordinates || coordinates.length < 3) return null;
  
  var wkt = 'POLYGON((';
  var points = [];
  
  coordinates.forEach(function(coord) {
    var lat = coord[0] || coord.lat || 0;
    var lng = coord[1] || coord.lng || 0;
    points.push(lng + ' ' + lat);
  });
  
  // Tutup polygon dengan titik pertama
  var first = coordinates[0];
  var firstLat = first[0] || first.lat || 0;
  var firstLng = first[1] || first.lng || 0;
  points.push(firstLng + ' ' + firstLat);
  
  wkt += points.join(',');
  wkt += '))';
  
  return wkt;
}

// Fungsi untuk update form koordinat
function updateKoordinatForm(coordinates) {
  if (!coordinates || coordinates.length === 0) return;
  
  var container = document.getElementById('koordinat-container');
  container.innerHTML = '';
  
  coordinates.forEach(function(coord, index) {
    var lat = coord[0] || coord.lat || coord.latitude || 0;
    var lng = coord[1] || coord.lng || coord.longitude || 0;
    
    var baris = document.createElement('div');
    baris.className = 'row mt-3 koordinat-row';
    
    if (index === 0) {
      baris.innerHTML = `
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="x[]" value="${lng}" placeholder="Koordinat X" required>
        </div>
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="y[]" value="${lat}" placeholder="Koordinat Y" required>
        </div>
        <div class="col-12 col-lg-2">
          <!-- kosong -->
        </div>
      `;
    } else {
      baris.innerHTML = `
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="x[]" value="${lng}" placeholder="Koordinat X" required>
        </div>
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="y[]" value="${lat}" placeholder="Koordinat Y" required>
        </div>
        <div class="col-12 col-lg-2">
          <button type="button" class="btn btn-danger btn-hapus"><i class="fas fa-trash"></i></button>
        </div>
      `;
    }
    container.appendChild(baris);
  });
}
// Fungsi untuk parsing WKT secara manual (fallback)
function parseWKTManually(wktString) {
  try {
    // Hapus prefix POLYGON((
    var clean = wktString.replace(/^POLYGON\s*\(\(/, '').replace(/\)\)\s*$/, '');
    var points = clean.split(',');
    
    var coordinates = [];
    points.forEach(function(point) {
      var coords = point.trim().split(/\s+/);
      if (coords.length >= 2) {
        var lng = parseFloat(coords[0]);
        var lat = parseFloat(coords[1]);
        if (!isNaN(lng) && !isNaN(lat)) {
          coordinates.push([lat, lng]); // Leaflet menggunakan [lat, lng]
        }
      }
    });
    
    // Hapus titik terakhir jika sama dengan titik pertama
    if (coordinates.length > 1) {
      var first = coordinates[0];
      var last = coordinates[coordinates.length - 1];
      if (first[0] === last[0] && first[1] === last[1]) {
        coordinates.pop();
      }
    }
    
    return coordinates;
  } catch(e) {
    console.error('Manual WKT parsing error:', e);
    return null;
  }
}
  // ============================================
  // INISIALISASI MAP
  // ============================================

  var southWest = L.latLng(-7.7228245, 111.2106116);
  var northEast = L.latLng(-7.5578955, 111.3991254);
  var bounds = L.latLngBounds(southWest, northEast);
  
  var map = L.map('map', {
    center: [-7.653612465060216, 111.32634662536874],
    zoom: 12,
    minZoom: 2,
    maxZoom: 15,
    fullscreenControl: true,
    fullscreenControlOptions: {
      position: 'topleft'
    }
  });

  // Base Layers
  var google_hybrid = L.gridLayer.googleMutant({
    type: 'hybrid'
  });
  
  var google_roadmap = L.gridLayer.googleMutant({
    type: 'roadmap'
  });
  
  var google_satelit = L.gridLayer.googleMutant({
    type: 'satellite'
  });
  
  var osm = L.tileLayer('https://{s}.tile.osm.org/{z}/{x}/{y}.png', {});
  var Esri_WorldImagery = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}');
  
  var RBI = L.esri.tiledMapLayer({
    url: "https://portal.ina-sdi.or.id/arcgis/rest/services/IGD/RupabumiIndonesia/MapServer"
  });

  (function() {
    var originalInitTile = L.GridLayer.prototype._initTile;
    L.GridLayer.include({
      _initTile: function(tile) {
        originalInitTile.call(this, tile);
        var tileSize = this.getTileSize();
        tile.style.width = tileSize.x + 1 + 'px';
        tile.style.height = tileSize.y + 1 + 'px';
      }
    });
  })();

  map.addLayer(google_hybrid);

  // ============================================
  // DRAW CONTROL UNTUK DIGITASI
  // ============================================

  var drawnItems = L.featureGroup().addTo(map);
  
  var options = {
    position: 'topleft',
    draw: {
      polyline: true,
      polygon: {
        allowIntersection: false,
        drawError: {
          color: '#e1e100',
          message: '<strong>Digitasi Salah!</strong>'
        },
        shapeOptions: {
          color: '#bada55'
        }
      },
      circle: false,
      rectangle: false,
      marker: false
    },
    edit: {
      featureGroup: drawnItems,
      remove: true
    }
  };

  var drawControl = new L.Control.Draw(options);
  map.addControl(drawControl);

  map.on(L.Draw.Event.CREATED, function(event) {
    drawnItems.clearLayers();
    var layer = event.layer;
    drawnItems.addLayer(layer);
    
    var wkt = toWKT(layer);
    if (wkt) {
      $('#SHAPE').val(wkt);
      wktKeKoordinat(wkt);
      
      var bounds = layer.getBounds();
      if (bounds && bounds.isValid()) {
        map.fitBounds(bounds);
      }
    }
  });

  map.on(L.Draw.Event.EDITED, function(event) {
    var layers = event.layers;
    layers.eachLayer(function(layer) {
      var wkt = toWKT(layer);
      if (wkt) {
        $('#SHAPE').val(wkt);
        wktKeKoordinat(wkt);
      }
    });
  });

  map.on(L.Draw.Event.DELETED, function(event) {
    $('#SHAPE').val('');
    $('#koordinat-container').html('');
    var container = document.getElementById('koordinat-container');
    var baris = document.createElement('div');
    baris.className = 'row mt-3 koordinat-row';
    baris.innerHTML = `
      <div class="col-12 col-lg-5">
        <input type="text" class="form-control" name="x[]" placeholder="Koordinat X" required>
      </div>
      <div class="col-12 col-lg-5">
        <input type="text" class="form-control" name="y[]" placeholder="Koordinat Y" required>
      </div>
      <div class="col-12 col-lg-2">
        <!-- kosong -->
      </div>
    `;
    container.appendChild(baris);
  });

  // ============================================
  // TOMBOL GAMBAR PETA, RESET, DAN ADD ROW
  // ============================================

  $(document).ready(function() {
    $('#parsepeta').on("click", function() {
      var wkt = koordinatKeWKT();
      if (wkt) {
        peta_pemohon(wkt);
      } else {
        swal({
          title: 'Peringatan',
          text: 'Masukkan minimal 3 titik koordinat yang valid terlebih dahulu!',
          icon: 'warning'
        });
      }
    });

    $('#reset_peta').on("click", function() {
      drawnItems.clearLayers();
      $('#SHAPE').val('');
      
      var container = document.getElementById('koordinat-container');
      container.innerHTML = '';
      
      var baris = document.createElement('div');
      baris.className = 'row mt-3 koordinat-row';
      baris.innerHTML = `
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="x[]" placeholder="Koordinat X" required>
        </div>
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="y[]" placeholder="Koordinat Y" required>
        </div>
        <div class="col-12 col-lg-2">
          <!-- kosong -->
        </div>
      `;
      container.appendChild(baris);
      
      map.setView([-7.653612465060216, 111.32634662536874], 12);
    });

    $('#addrow').on("click", function() {
      var container = document.getElementById('koordinat-container');
      var barisBaru = document.createElement('div');
      barisBaru.className = 'row mt-3 koordinat-row';
      barisBaru.innerHTML = `
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="x[]" placeholder="Koordinat X" required>
        </div>
        <div class="col-12 col-lg-5">
          <input type="text" class="form-control" name="y[]" placeholder="Koordinat Y" required>
        </div>
        <div class="col-12 col-lg-2">
          <button type="button" class="btn btn-danger btn-hapus"><i class="fas fa-trash"></i></button>
        </div>
      `;
      container.appendChild(barisBaru);
    });

    $(document).on('click', '.btn-hapus', function() {
      var row = $(this).closest('.koordinat-row');
      if (row && $('.koordinat-row').length > 1) {
        row.remove();
      } else {
        swal({
          title: 'Peringatan',
          text: 'Minimal harus ada 1 baris koordinat!',
          icon: 'warning'
        });
      }
    });
  });

  // ============================================
  // LOAD KECAMATAN & DESA
  // ============================================

  var kabupaten_layer = new L.GeoJSON();
  var desa_layer = new L.GeoJSON();
  var rdtr_layer = new L.GeoJSON();
  var kabmagetan_layer = new L.GeoJSON();
  var popup = new L.popup();

  var style_kabupaten = {
    color: "yellow",
    weight: 3,
    opacity: 1,
    fillOpacity: 0,
    dashArray: 3
  };

  var style_desa = {
    color: "white",
    weight: 1,
    opacity: 1,
    fillOpacity: 0,
    dashArray: 3
  };

  var label_kec = [];
  var label_desa = [];

  function topojsonToGeojson(data) {
    if (data.type === "Topology") {
      var geojson = {
        type: "FeatureCollection",
        features: []
      };
      for (var key in data.objects) {
        var feature = topojson.feature(data, data.objects[key]);
        if (feature.features) {
          geojson.features = geojson.features.concat(feature.features);
        } else {
          geojson.features.push(feature);
        }
      }
      return geojson;
    }
    return data;
  }

  function loadGeoJsonkec(data) {
    var geojsonData = topojsonToGeojson(data);
    kabupaten_layer.clearLayers();
    kabupaten_layer.addData(geojsonData);
    kabupaten_layer.addTo(map);
    
    var i = 0;
    kabupaten_layer.eachLayer(function(layer) {
      layer.setStyle(style_kabupaten);
      var bounds = layer.getBounds();
      if (bounds && bounds.isValid()) {
        var center = bounds.getCenter();
        
        label_kec[i] = new L.Tooltip({
          noHide: false,
          direction: 'auto',
          permanent: true
        });
        
        var labelText = layer.feature.properties.kab || layer.feature.properties.kecamatan || '';
        label_kec[i].setContent(labelText);
        label_kec[i].setLatLng(center);
        map.showLabel(label_kec[i]);
        i++;
      }
    });
    
    hide_label_kec();

    if (kabupaten_layer.getLayers().length > 0) {
      var bounds = kabupaten_layer.getBounds();
      if (bounds && bounds.isValid()) {
        map.fitBounds(bounds, {
          padding: [20, 20],
          maxZoom: 12
        });
      }
    }
  }

  function loadGeoJsondesa(data) {
    var geojsonData = topojsonToGeojson(data);
    hapus_label_desa();
    desa_layer.clearLayers();
    desa_layer.addData(geojsonData);
    desa_layer.addTo(map);
    
    var i = 0;
    desa_layer.eachLayer(function(layer) {
      layer.setStyle(style_desa);
      var bounds = layer.getBounds();
      if (bounds && bounds.isValid()) {
        var center = bounds.getCenter();
        
        label_desa[i] = new L.Tooltip({
          noHide: false,
          direction: 'auto',
          permanent: true
        });
        
        var labelText = layer.feature.properties.desa || layer.feature.properties.namobj || '';
        label_desa[i].setContent(labelText);
        label_desa[i].setLatLng(center);
        label_desa[i].setOpacity(0);
        map.showLabel(label_desa[i]);
        i++;
      }
    });
    
    tampil_label_desa();
    map.removeLayer(drawnItems);
    drawnItems.addTo(map);
  }

  function loadRdtr(data) {
    var geojsonData = topojsonToGeojson(data);
    rdtr_layer.clearLayers();
    rdtr_layer.addData(geojsonData);
    rdtr_layer.addTo(map);
    rdtr_layer.eachLayer(function(layer) {
      layer.setStyle({
        color: '#ff7800',
        weight: 2,
        opacity: 0.8,
        fillOpacity: 0.3,
        fillColor: '#ff7800'
      });
      var props = layer.feature.properties;
      var popupContent = '<b>Nama:</b> ' + (props.namobj || '') +
                         '<br><b>Kode Sub Z:</b> ' + (props.kode_sub_z || '');
      layer.bindPopup(popupContent);
    });
  }

  function loadKabmagetan(data) {
    var geojsonData = topojsonToGeojson(data);
    kabmagetan_layer.clearLayers();
    kabmagetan_layer.addData(geojsonData);
    kabmagetan_layer.addTo(map);
    kabmagetan_layer.eachLayer(function(layer) {
      layer.setStyle({
        color: '#3388ff',
        weight: 2,
        opacity: 0.8,
        fillOpacity: 0.3,
        fillColor: '#3388ff'
      });
      var props = layer.feature.properties;
      var popupContent = '<b>Nama:</b> ' + (props.namobj || '');
      layer.bindPopup(popupContent);
    });
  }

  function hapus_label_kec() {
    for (var i = 0; i < label_kec.length; i++) {
      if (label_kec[i]) {
        map.removeLayer(label_kec[i]);
      }
    }
    label_kec = [];
  }

  function tampil_label_kec() {
    for (var i = 0; i < label_kec.length; i++) {
      if (label_kec[i]) {
        label_kec[i].setOpacity(1);
      }
    }
  }

  function hide_label_kec() {
    for (var i = 0; i < label_kec.length; i++) {
      if (label_kec[i]) {
        label_kec[i].setOpacity(0);
      }
    }
  }

  function hapus_label_desa() {
    for (var i = 0; i < label_desa.length; i++) {
      if (label_desa[i]) {
        map.removeLayer(label_desa[i]);
      }
    }
    label_desa = [];
  }

  function tampil_label_desa() {
    for (var i = 0; i < label_desa.length; i++) {
      if (label_desa[i]) {
        label_desa[i].setOpacity(1);
      }
    }
  }

  function hide_label_desa() {
    for (var i = 0; i < label_desa.length; i++) {
      if (label_desa[i]) {
        label_desa[i].setOpacity(0);
      }
    }
  }

  // Load data
  $.getJSON(rooturl + "/peta/topojson_kec").done(loadGeoJsonkec);
  
  $.getJSON(rooturl + "/peta/topojson_rdtr")
    .done(loadRdtr)
    .fail(function(jqXHR, textStatus, errorThrown) {
      console.error('Gagal load RDTR:', textStatus, errorThrown);
    });
    
  $.getJSON(rooturl + "/peta/topojson_kabmagetan")
    .done(loadKabmagetan)
    .fail(function(jqXHR, textStatus, errorThrown) {
      console.error('Gagal load Kab Magetan:', textStatus, errorThrown);
    });

  var wellmaxzoom = 13;
  
  map.on('moveend', function() {
    if (map.getZoom() > 9) {
      tampil_label_kec();
    } else {
      hide_label_kec();
    }
    
    if (map.getZoom() > wellmaxzoom) {
      var kiri_atas_lng = map.getBounds().getSouthWest().lng;
      var kiri_atas_lat = map.getBounds().getSouthWest().lat;
      var kanan_bawah_lng = map.getBounds().getNorthEast().lng;
      var kanan_bawah_lat = map.getBounds().getNorthEast().lat;
      
      var geoJsonUrl = rooturl + "peta/topojson_desa?kiri_lng=" + kiri_atas_lng + 
                       "&kiri_lat=" + kiri_atas_lat + 
                       "&kanan_lng=" + kanan_bawah_lng + 
                       "&kanan_lat=" + kanan_bawah_lat;
      
      $.getJSON(geoJsonUrl).done(loadGeoJsondesa);
    } else {
      hapus_label_desa();
      map.removeLayer(desa_layer);
    }
  });

  // ============================================
  // LAYER CONTROL
  // ============================================

  var baseLayers = {
    "Google Roadmap": google_roadmap,
    "Google Hybrid": google_hybrid,
    "Google Satellite": google_satelit,
    "Open Street Map": osm,
    "ESRI World Imagery": Esri_WorldImagery,
    "RBI": RBI
  };

  var groupedOverlays = {
    "Administrasi": {
      "&nbsp;&nbsp;Kabupaten": kabupaten_layer
    },
    "Layer": {
      "<span>&nbsp;&nbsp;RDTR Karangrejo</span>&nbsp;&nbsp;<span style='background-color:#ff7800;padding:2px 8px 2px 8px;'></span>": rdtr_layer,
      "<span>&nbsp;&nbsp;Pola Ruang Kab Magetan</span>&nbsp;&nbsp;<span style='background-color:#3388ff;padding:2px 8px 2px 8px;'></span>": kabmagetan_layer
    }
  };

  var options = {
    collapsed: true,
    groupCheckboxes: false
  };

  L.control.groupedLayers(baseLayers, groupedOverlays, options).addTo(map);

  L.control.scale({
    position: 'bottomright',
    metric: true,
    imperial: false
  }).addTo(map);

  var legend = L.control({ position: 'bottomleft' });
  legend.onAdd = function(map) {
    var div = L.DomUtil.create('div', 'info-legend');
    div.innerHTML = '<i style="background:#bada55;"></i> Digitasi Peta';
    return div;
  };
  legend.addTo(map);

  map.on('click', function(e) {
    console.log(e.latlng.lat + ' ' + e.latlng.lng);
    $('#xe').val(e.latlng.lng);
    $('#ye').val(e.latlng.lat);
  });

  function clickHandler(e) {
    $('#xe').val(e.latlng.lng);
    $('#ye').val(e.latlng.lat);
  }
</script>