<!-- modal ubah password -->
 <div class="modal fade modal-ubah-password" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabel">Ubah Password</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label for="exampleInputEmail1">Password Baru</label>
          <div style="position: relative;background-color: ;">
            <input type="password" class="form-control" id="pwd" name="pwd" placeholder="Masukkan password baru anda">
            <i class="fa fa-eye-slash" id="iconne" aria-hidden="true" style="position: absolute;right:10px;top:13px;font-size: 16px;cursor: pointer;" onclick="myFunction()"></i>
          </div>
          <small id="emailHelp" class="form-text text-muted">Pastikan password Anda minimal 10 karakter dan mengandung huruf besar, huruf kecil, dan angka.</small>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-lg" data-dismiss="modal">Tutup</button>
        <button type="button" class="btn btn-primary btn-lg" onclick="ganti_password()">Simpan</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
    var rooturl = ''
    let id = 0
    function myFunction() {
      $("#iconne").toggleClass("fa fa-eye-slash fa fa-eye");
      var x = document.getElementById("pwd");
      if (x.type === "password") {
        x.type = "text";
      } else {
        x.type = "password";
      }
    }

    let data_table  =$('#list-data').DataTable({
      "language": {
          "sProcessing":   "Sedang memproses...",
          "sLengthMenu":   "_MENU_",
          "sZeroRecords":  "Tidak ditemukan data yang sesuai",
          "sInfo":         "Menampilkan _START_ sampai _END_ dari _TOTAL_ entri",
          "sInfoEmpty":    "Menampilkan 0 sampai 0 dari 0 entri",
          "sInfoFiltered": "(disaring dari _MAX_ entri keseluruhan)",
          "sInfoPostFix":  "",
          "sUrl":          "",
          "oPaginate": {
            "sFirst":    "Pertama",
            "sPrevious": "Sebelumnya",
            "sNext":     "Selanjutnya",
            "sLast":     "Terakhir"
          }
      },
      "processing": true,
      "ajax":  `${rooturl}/manajemen_users/list${'<%=user.is_admin%>'!=1?'?id_user=<%=user.id_user%>':''}`,
      "columns": [
        { "data": null},
        { "data": "fullname"},
        { "data": "NIP"},
        { "data": "email"},
        { "data": "is_admin",render : function (data) {
          return data==1?'Administrator': data==2?'UPTD':''
        }},
        { "data": "id_user",render: function(data){
          let a = ''
          if (data) {
            a = `
                <ul class="list-inline mb-0" style="text-align:center">
                  <li class="list-inline-item"><a href="${rooturl}/manajemen_users/edit/${data}" class="btn btn-warning"><i class="fas fa-edit"></i></a></li>
                  <li class="list-inline-item"><button  onclick="hapus(${data})"  class="btn btn-danger"><i class="fa fa-trash"></i></button></li>
                  <li class="list-inline-item"><button  onclick="ganti_id(${data})" data-toggle="modal" data-target=".modal-ubah-password" class="btn btn-dark" style="margin-right:0;"><i class="fa fa-key"></i></button></li>
                </ul>`
          }
          return `<td><center>${a}</center></td>`
        }},
      ],
      "columnDefs": [
        { "width": "40px", "targets": 0},
        { "width": "160px", "targets": 5}
      ],
    });

    data_table.on( 'draw.dt', function () {
      let PageInfo = $('#list-data').DataTable().page.info();
      data_table.column(0, { page: 'current' }).nodes().each( function (cell, i) {
        cell.innerHTML = i + 1 + PageInfo.start;
      });
    });
    async function ganti_id(prm) {
      id=prm
    }
  async function ganti_password() {
    const will_update = await swal({
      title: "Edit Data",
      text: "Apakah anda akan mengedit data ini?",
      icon: "warning",
      dangerMode: true,
      buttons: ["Tidak", "Ya"],
    });
    
    let a = 0
    let b = 0
    let c = 0
    let d = 0
    if ($('#pwd').val()) {
      for (let i = 0; i < $('#pwd').val().length; i++) {
          if ( $('#pwd').val().charCodeAt(i) >=49 &&$('#pwd').val().charCodeAt(i) <=57 ) {
          a+=1
          }else if ( $('#pwd').val().charCodeAt(i) >=65 &&$('#pwd').val().charCodeAt(i) <=90 ) {
          b+=1
          }else if ( $('#pwd').val().charCodeAt(i) >=97 &&$('#pwd').val().charCodeAt(i) <=122 ) {
          c+=1
          }else{
          d+=1
          }
      }
    }else{
      a=1
      b=1
      c=1
      d=1
    }

    if (a!=0&&b!=0&&c!=0&&d!=0) {
      if ( will_update) {
        $('#button_submit').empty()
        $('#button_submit').append('<button class="btn btn-primary btn-embossed" disabled>Simpan</button>')
        let formData = new FormData();    
        // nama kolom db        
        formData.append('id_user', id);
        formData.append('pwd',$('#pwd').val())
        $.ajax({
          type: 'POST',
          enctype: 'multipart/form-data',
          url: rooturl+'/user/edit',
          data: formData,
          processData: false,
          contentType: false,
          success: function(data) {
            swal({title:text_edit.title,text:text_edit.text, icon: text_edit.icon, type:text_edit.type})
            window.location.href = rooturl+'/manajemen_users';
          },error: function(data) {
            swal({title:text_error.title,text:text_error.text, icon: text_error.icon, type:text_error.type})
          }
        })      
      } 
    }else{
      swal({title:text_error.title,text:text_error.text, icon: text_error.icon, type:text_error.type})
    }
  }      

    async function hapus(id) {
      const willDelete = await swal({
        title: "Hapus Data",
        text: "Apakah anda akan menghapus data ini?",
        icon: "warning",
        dangerMode: true,
        buttons: ["Tidak", "Ya"],
      });
              
      if ( willDelete) {
        $.get(rooturl+"/manajemen_users/hapus/"+id).then(function (hsl) {
          // alert('Sukses')
          swal({title:text_delete.title,text:text_delete.text, icon: text_delete.icon, type:text_delete.type})
          data_table.ajax.url(rooturl+"/manajemen_users/list").load();
        })
      }
    }
</script>